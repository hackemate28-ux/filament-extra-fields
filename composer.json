{
    "name": "hackemate28-ux/filament-extra-fields",
    "description": "Extra form fields for Filament v4, built on native primitives — starting with a fused number-with-unit input.",
    "keywords": [
        "filament",
        "filamentphp",
        "laravel",
        "forms",
        "fields"
    ],
    "homepage": "https://github.com/hackemate28-ux/filament-extra-fields",
    "license": "MIT",
    "authors": [
        {
            "name": "HackeMate",
            "email": "hackemate28@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/forms": "^4.0",
        "filament/schemas": "^4.0",
        "filament/support": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "HackeMate\\FilamentExtraFields\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HackeMate\\FilamentExtraFields\\FilamentExtraFieldsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
